<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <AssemblyName>YuukoChanSample</AssemblyName>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyTitle>RabotoraX Windows YuukoChan Visual Novel Sample Test Project</AssemblyTitle>
        <Company>Misaka Castle Group and RabotoraX Contributors</Company>
        <Copyright>(C) Misaka Castle Group and RabotoraX Contributors. All rights reserved. Licensed under 123 Open-Source Organization MIT Public License 2.0.</Copyright>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>
        <PublishAot>true</PublishAot>
        <ImportWindowsDesktopTargets>false</ImportWindowsDesktopTargets>
        <ApplicationManifest>App.manifest</ApplicationManifest>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\RabotoraX.Core\RabotoraX.Core.csproj" />
      <ProjectReference Include="..\RabotoraX.YuukoChan\RabotoraX.YuukoChan.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <ProjectReference Include="..\RabotoraX.Analyzers\RabotoraX.Analyzers.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
        <ProjectReference Include="..\RabotoraX.CodeFix\RabotoraX.CodeFix.csproj"
                          OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    </ItemGroup>

</Project>
