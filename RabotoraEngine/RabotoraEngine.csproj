<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UseWindowsForms>true</UseWindowsForms>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <AssemblyName>RabotoraEngine</AssemblyName>
        <RootNamespace>Rabotora</RootNamespace>
        <AssemblyTitle>Rabotora Visual Novel Engine Core Library</AssemblyTitle>
        <Company>Misaka Castle, Rabotora Tower Project and all Rabotora contributors</Company>
        <Copyright>(C)Copyright 2021-2025 Rabotora Tower Project</Copyright>
        <Version>0.0.1-alpha</Version>
        <Authors>Rabotora Tower Project</Authors>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="SkiaSharp" Version="3.116.1" />
      <PackageReference Include="Vortice.D3DCompiler" Version="3.6.2" />
      <PackageReference Include="Vortice.Direct2D1" Version="3.6.2" />
      <PackageReference Include="Vortice.Direct3D11" Version="3.6.2" />
    </ItemGroup>

    <ItemGroup>
      <ClCompile Include="Resources\Internal\Shaders\PixelShader.hlsl" />
    </ItemGroup>

</Project>